    "QR-коды для Google Authenticator на iPhone. Недоступны аккаунты, чьи коды Google Authenticator показал бы неверно.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "QR codes for Google Authenticator on iPhone. Accounts whose codes Google Authenticator would show incorrectly are unavailable."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "QR-коды для Google Authenticator на iPhone. Недоступны аккаунты, чьи коды Google Authenticator показал бы неверно."
          }
        }
      }
    },
    "Touch ID": {
